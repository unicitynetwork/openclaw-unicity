{
  "name": "@unicitylabs/openclaw-unicity",
  "version": "0.6.0",
  "description": "Unicity wallet identity and encrypted DMs for OpenClaw agents — powered by Sphere SDK",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unicitynetwork/openclaw-unicity.git"
  },
  "homepage": "https://github.com/unicitynetwork/openclaw-unicity#readme",
  "bugs": {
    "url": "https://github.com/unicitynetwork/openclaw-unicity/issues"
  },
  "keywords": [
    "unicity",
    "openclaw",
    "nostr",
    "wallet",
    "agent",
    "dm",
    "sphere-sdk"
  ],
  "files": [
    "dist/**/*",
    "src/**/*",
    "openclaw.plugin.json",
    "assets/icon.png",
    "LICENSE",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "unicity",
      "label": "Unicity",
      "blurb": "Private Nostr DMs, group chat and token payments via the Unicity Sphere SDK.",
      "doctorCapabilities": {
        "openDmRequiresAllowFromWildcard": false
      }
    },
    "compat": {
      "pluginApi": ">=2026.10.2"
    },
    "install": {
      "npmSpec": "@unicitylabs/openclaw-unicity",
      "minHostVersion": ">=2026.10.2"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "UNICITY_E2E=1 vitest run --config vitest.e2e.config.ts --exclude test/e2e/plugin-lifecycle-docker.test.ts",
    "test:e2e:docker": "UNICITY_E2E=1 vitest run --config vitest.e2e.config.ts test/e2e/plugin-lifecycle-docker.test.ts",
    "lint": "oxlint src/ test/",
    "pack:local": "npm run build && npm pack"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@unicitylabs/sphere-sdk": "^0.18.1",
    "typebox": "^1.3.34",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openclaw": "2026.10.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}
